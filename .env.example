# ==============================================================
# LIFEVERSE - Unified Environment Configuration Example
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018/lifeverse

# Authentication Secrets
JWT_ACCESS_SECRET=lifeverse_jwt_access_secret_production_ready_super_secure_key_2026
JWT_REFRESH_SECRET=lifeverse_jwt_refresh_secret_production_ready_super_secure_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS & Client Origins
WEB_ORIGIN=http://localhost:5173
MOBILE_ORIGIN=http://localhost:8081

# Initial Administrator Seed
ADMIN_EMAIL=admin@lifeverse.io
ADMIN_PASSWORD=AdminLifeverse2026!
ADMIN_USERNAME=LifeverseAdmin

# Email / SMTP (Fallback to safe console logger in dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_password
EMAIL_FROM=LIFEVERSE <no-reply@lifeverse.io>

# Cloudinary / Media (Optional, fallback to local uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client Environments
VITE_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
